{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UAMP chained signed incremental delta v2 envelope",
  "$comment": "This is a transport envelope, not a core request. Validate exact canonical payload digest, sender key equality, Ed25519 proofs, current trust, cursor order, unique dispositions, dependency closure and prior accepted head separately. A publication_review is evidence of a sender's decision, never authorization for the receiving host. Whole envelope maximum is 4 MiB including final LF.",
  "type": "object",
  "required": ["payload", "proof"],
  "properties": {
    "payload": {"$ref": "#/$defs/payload"},
    "proof": {
      "allOf": [
        {"$ref": "signed.schema.json"},
        {"properties": {"schema_version": {"const": "universal-memory-message-signature/v1"}}}
      ]
    }
  },
  "additionalProperties": false,
  "x-maxUtf8Bytes": 4194304,
  "$defs": {
    "payload": {
      "type": "object",
      "required": ["schema_version", "source_store_id", "sender_key_id", "after", "cursor", "records", "attestations", "blocked", "previous_batch_sha256", "publication_review", "group"],
      "properties": {
        "schema_version": {"const": "universal-memory-delta/v2"},
        "source_store_id": {"$ref": "common.schema.json#/$defs/store_id"},
        "sender_key_id": {"$ref": "common.schema.json#/$defs/key_id"},
        "after": {"type": "integer", "minimum": 0, "maximum": 9223372036854775806},
        "cursor": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "records": {"type": "array", "maxItems": 1024, "items": {"$ref": "record.schema.json"}},
        "attestations": {
          "type": "object",
          "maxProperties": 1024,
          "propertyNames": {"$ref": "common.schema.json#/$defs/memory_id"},
          "additionalProperties": {
            "allOf": [
              {"$ref": "signed.schema.json"},
              {"properties": {"schema_version": {"const": "universal-memory-attestation/v1"}}}
            ]
          }
        },
        "blocked": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/disposition"}},
        "previous_batch_sha256": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/digest"}]},
        "publication_review": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/publication_review"}]},
        "group": {"oneOf": [{"type": "null"}, {"$ref": "fragment-group.schema.json"}]}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"after": {"const": 0}}},
          "then": {"properties": {"previous_batch_sha256": {"type": "null"}}},
          "else": {"properties": {"previous_batch_sha256": {"$ref": "common.schema.json#/$defs/digest"}}}
        },
        {
          "if": {"properties": {"group": {"type": "object"}}},
          "then": {"properties": {"records": {"maxItems": 0}, "attestations": {"maxProperties": 0}}}
        },
        {
          "if": {"properties": {"blocked": {"contains": {"properties": {"reason": {"const": "operator_excluded"}}, "required": ["reason"]}}}},
          "then": {"properties": {"publication_review": {"$ref": "#/$defs/publication_review"}}}
        }
      ]
    },
    "disposition": {
      "type": "object",
      "required": ["memory_id", "sequence", "reason"],
      "properties": {
        "memory_id": {"$ref": "common.schema.json#/$defs/memory_id"},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "reason": {"enum": ["dependency_not_admitted", "dependency_budget_exceeded", "unsigned_dependency", "operator_excluded"]}
      },
      "additionalProperties": false,
      "$comment": "Each sequence is unique and must be in (after,cursor]. A disposition means non-delivery, not receipt. New full-group senders must not use a size-only disposition to skip a core-supported closure; the legacy reason remains readable."
    },
    "publication_review": {
      "type": "object",
      "required": ["schema_version", "request_id", "replaces_unpublished_batch_sha256", "selection_sha256", "excluded_records", "retained_records"],
      "properties": {
        "schema_version": {"const": "universal-memory-publication-review/v1"},
        "request_id": {"$ref": "common.schema.json#/$defs/request_id"},
        "replaces_unpublished_batch_sha256": {"$ref": "common.schema.json#/$defs/digest"},
        "selection_sha256": {"$ref": "common.schema.json#/$defs/digest"},
        "excluded_records": {"type": "integer", "minimum": 0, "maximum": 100000},
        "retained_records": {"type": "integer", "minimum": 0, "maximum": 100000}
      },
      "additionalProperties": false,
      "$comment": "selection_sha256 hashes canonical {excluded:[sorted complete excluded IDs],retained:[sorted retained IDs]}. Retained count equals inline length or group record_count. Full selections and local-path allowances stay in the sender's independent protected operator journal; memory cannot create that authority."
    }
  }
}
