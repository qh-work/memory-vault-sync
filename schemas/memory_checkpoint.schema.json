{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-memory-vault.invalid/schemas/memory_checkpoint.schema.json",
  "title": "Memory Checkpoint v1",
  "description": "单个语义任务或整个保险库基于明确任务指针集合与事件集合生成的不可变、可重建视图。",
  "type": "object",
  "required": [
    "schema_version",
    "checkpoint_id",
    "scope",
    "authority",
    "basis",
    "summary",
    "hash_profile",
    "created_at",
    "checkpoint_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "memory-checkpoint/v1"
    },
    "checkpoint_id": {
      "$ref": "#/$defs/safe_id"
    },
    "scope": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "task",
            "vault"
          ]
        },
        "id": {
          "$ref": "#/$defs/safe_id"
        }
      },
      "additionalProperties": false
    },
    "authority": {
      "const": "cache_only"
    },
    "basis": {
      "type": "object",
      "required": [
        "git_commit_sha",
        "task_currents",
        "event_heads",
        "event_set_sha256"
      ],
      "properties": {
        "git_commit_sha": {
          "$ref": "#/$defs/git_object_sha"
        },
        "task_currents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "semantic_task_id",
              "current_blob_sha",
              "task_generation",
              "snapshot_id",
              "transaction_id"
            ],
            "properties": {
              "semantic_task_id": {
                "$ref": "#/$defs/safe_id"
              },
              "current_blob_sha": {
                "$ref": "#/$defs/git_object_sha"
              },
              "task_generation": {
                "type": "integer",
                "minimum": 0
              },
              "snapshot_id": {
                "$ref": "#/$defs/safe_id"
              },
              "transaction_id": {
                "$ref": "#/$defs/safe_id"
              }
            },
            "additionalProperties": false
          }
        },
        "event_heads": {
          "$ref": "#/$defs/event_ids"
        },
        "event_set_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "current_goal",
        "completed",
        "next_actions",
        "active_constraint_event_ids",
        "unresolved_conflict_event_ids",
        "candidate_artifact_ids",
        "task_continuations",
        "known_gaps"
      ],
      "properties": {
        "current_goal": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            {
              "type": "null"
            }
          ]
        },
        "completed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "next_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "active_constraint_event_ids": {
          "$ref": "#/$defs/event_ids"
        },
        "unresolved_conflict_event_ids": {
          "$ref": "#/$defs/event_ids"
        },
        "candidate_artifact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safe_id"
          }
        },
        "task_continuations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "semantic_task_id",
              "snapshot_id"
            ],
            "properties": {
              "semantic_task_id": {
                "$ref": "#/$defs/safe_id"
              },
              "snapshot_id": {
                "$ref": "#/$defs/safe_id"
              }
            },
            "additionalProperties": false
          }
        },
        "known_gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      },
      "additionalProperties": false
    },
    "hash_profile": {
      "const": "jcs-rfc8785+sha256/checkpoint-v1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "checkpoint_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "safe_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$",
      "not": {
        "enum": ["con", "prn", "aux", "nul", "com1", "com2", "com3", "com4", "com5", "com6", "com7", "com8", "com9", "lpt1", "lpt2", "lpt3", "lpt4", "lpt5", "lpt6", "lpt7", "lpt8", "lpt9"]
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "git_object_sha": {
      "type": "string",
      "pattern": "^(?!(?:0{40}|0{64})$)(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "event_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/safe_id"
      }
    }
  },
  "$comment": "task scope 必须恰好包含一个与 scope.id 相同的 task_currents 项；vault scope 可包含多个且 task id 不得重复。event_set_sha256=SHA-256(JCS(按 memory_event_id 字节序排序的 [{memory_event_id,event_sha256}] 数组))；checkpoint_sha256=SHA-256(JCS(checkpoint 去掉 checkpoint_sha256 字段))。"
}
