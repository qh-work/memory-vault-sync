{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-memory-vault.invalid/schemas/memory_host_request.schema.json",
  "title": "Memory Vault model-neutral host request v1",
  "description": "A closed, bounded request envelope for local host adapters. Native conversation, session, turn, task, project, owner, model, policy, permission and execution identifiers are not part of this protocol.",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_version",
    "request_id",
    "operation",
    "adapter",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "memory-vault-host-request/v1"
    },
    "protocol_version": {
      "const": "1.0"
    },
    "request_id": {
      "$ref": "#/$defs/request_id"
    },
    "operation": {
      "enum": [
        "capabilities",
        "session.open",
        "turn.input",
        "turn.commit",
        "turn.abort",
        "session.close",
        "memory.recall",
        "memory.remember",
        "memory.status",
        "sync.flush"
      ]
    },
    "adapter": {
      "$ref": "#/$defs/adapter"
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "operation": {
          "const": "capabilities"
        },
        "payload": {
          "$ref": "#/$defs/empty_payload"
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "session.open"
        },
        "payload": {
          "$ref": "#/$defs/session_open_payload"
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "turn.input"
        },
        "payload": {
          "$ref": "#/$defs/turn_input_payload"
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "turn.commit"
        },
        "payload": {
          "$ref": "#/$defs/turn_commit_payload"
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "turn.abort"
        },
        "payload": {
          "$ref": "#/$defs/turn_abort_payload"
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "session.close"
        },
        "payload": {
          "$ref": "#/$defs/session_close_payload"
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "memory.recall"
        },
        "payload": {
          "$ref": "#/$defs/memory_recall_payload"
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "memory.remember"
        },
        "payload": {
          "$ref": "#/$defs/memory_remember_payload"
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "memory.status"
        },
        "payload": {
          "$ref": "#/$defs/empty_payload"
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "sync.flush"
        },
        "payload": {
          "$ref": "#/$defs/empty_payload"
        }
      }
    }
  ],
  "$defs": {
    "request_id": {
      "type": "string",
      "description": "Adapter-issued safe opaque idempotency key. It must not contain or be a native host identifier.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+-]{0,159}$"
    },
    "continuity_handle": {
      "type": "string",
      "description": "Vault-issued opaque continuity handle; local transport state only.",
      "pattern": "^mvc1_[A-Za-z0-9_-]{43}$"
    },
    "turn_handle": {
      "type": "string",
      "description": "Vault-issued opaque turn handle; local transport state only.",
      "pattern": "^mvt1_[A-Za-z0-9_-]{43}$"
    },
    "adapter": {
      "type": "object",
      "description": "Local delivery provenance only. These fields never enter durable identity, ownership, recall filtering, authorization or memory lifecycle decisions.",
      "required": [
        "id",
        "version",
        "host_family"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
        },
        "version": {
          "type": "string",
          "minLength": 5,
          "maxLength": 64,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
        },
        "host_family": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
        }
      },
      "additionalProperties": false
    },
    "empty_payload": {
      "type": "object",
      "maxProperties": 0,
      "additionalProperties": false
    },
    "session_open_payload": {
      "type": "object",
      "required": [
        "continuity_handle",
        "reason"
      ],
      "properties": {
        "continuity_handle": {
          "oneOf": [
            {
              "$ref": "#/$defs/continuity_handle"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "enum": [
            "startup",
            "resume",
            "clear",
            "compact"
          ]
        }
      },
      "additionalProperties": false
    },
    "turn_input_payload": {
      "type": "object",
      "required": [
        "continuity_handle",
        "turn_handle",
        "visible_user_text",
        "limit"
      ],
      "properties": {
        "continuity_handle": {
          "$ref": "#/$defs/continuity_handle"
        },
        "turn_handle": {
          "oneOf": [
            {
              "$ref": "#/$defs/turn_handle"
            },
            {
              "type": "null"
            }
          ]
        },
        "visible_user_text": {
          "$ref": "#/$defs/visible_text"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      },
      "additionalProperties": false
    },
    "turn_commit_payload": {
      "type": "object",
      "description": "All five fields are present. Visible text fields and turn_handle may be null only where the lifecycle constraints below allow it.",
      "required": [
        "continuity_handle",
        "turn_handle",
        "outcome",
        "visible_user_text",
        "visible_assistant_text"
      ],
      "properties": {
        "continuity_handle": {
          "$ref": "#/$defs/continuity_handle"
        },
        "turn_handle": {
          "oneOf": [
            {
              "$ref": "#/$defs/turn_handle"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "const": "final"
        },
        "visible_user_text": {
          "$ref": "#/$defs/optional_visible_text"
        },
        "visible_assistant_text": {
          "$ref": "#/$defs/optional_visible_text"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "properties": {
            "visible_assistant_text": {
              "$ref": "#/$defs/visible_text"
            }
          }
        },
        {
          "if": {
            "properties": {
              "turn_handle": {
                "type": "null"
              }
            },
            "required": [
              "turn_handle"
            ]
          },
          "then": {
            "properties": {
              "visible_user_text": {
                "$ref": "#/$defs/visible_text"
              }
            }
          }
        }
      ]
    },
    "turn_abort_payload": {
      "type": "object",
      "required": [
        "continuity_handle",
        "turn_handle",
        "reason"
      ],
      "properties": {
        "continuity_handle": {
          "$ref": "#/$defs/continuity_handle"
        },
        "turn_handle": {
          "$ref": "#/$defs/turn_handle"
        },
        "reason": {
          "enum": [
            "cancelled",
            "host_error",
            "user_interrupt",
            "unknown"
          ]
        }
      },
      "additionalProperties": false
    },
    "session_close_payload": {
      "type": "object",
      "required": [
        "continuity_handle"
      ],
      "properties": {
        "continuity_handle": {
          "$ref": "#/$defs/continuity_handle"
        }
      },
      "additionalProperties": false
    },
    "memory_recall_payload": {
      "type": "object",
      "required": [
        "query",
        "limit",
        "maximum_context_bytes"
      ],
      "properties": {
        "query": {
          "$ref": "#/$defs/recall_query_text"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "maximum_context_bytes": {
          "type": "integer",
          "minimum": 512,
          "maximum": 65536
        }
      },
      "additionalProperties": false
    },
    "memory_remember_payload": {
      "type": "object",
      "required": [
        "proposal"
      ],
      "properties": {
        "proposal": {
          "$ref": "#/$defs/semantic_proposal"
        }
      },
      "additionalProperties": false
    },
    "semantic_proposal": {
      "type": "object",
      "description": "A taskless semantic proposal anchored to an existing visible episode. It carries no execution or policy authority.",
      "required": [
        "schema_version",
        "source_id",
        "episode_id",
        "kind",
        "claim_key",
        "parents",
        "supersedes",
        "conflicts_with",
        "resolves",
        "payload"
      ],
      "properties": {
        "schema_version": {
          "const": "memory-network-semantic-proposal/v1"
        },
        "source_id": {
          "$ref": "#/$defs/source_id"
        },
        "episode_id": {
          "$ref": "#/$defs/episode_id"
        },
        "kind": {
          "enum": [
            "decision",
            "constraint",
            "progress",
            "next_action",
            "hypothesis",
            "artifact_created",
            "artifact_verified",
            "correction",
            "user_preference",
            "conflict_declared",
            "conflict_resolved",
            "checkpoint_note"
          ]
        },
        "claim_key": {
          "oneOf": [
            {
              "$ref": "#/$defs/safe_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "parents": {
          "$ref": "#/$defs/event_ids"
        },
        "supersedes": {
          "$ref": "#/$defs/event_ids"
        },
        "conflicts_with": {
          "$ref": "#/$defs/event_ids"
        },
        "resolves": {
          "$ref": "#/$defs/event_ids"
        },
        "payload": {
          "$ref": "#/$defs/semantic_claim"
        }
      },
      "additionalProperties": false
    },
    "semantic_claim": {
      "type": "object",
      "required": [
        "statement",
        "reason",
        "concepts"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "reason": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            {
              "type": "null"
            }
          ]
        },
        "concepts": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "additionalProperties": false
    },
    "visible_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2097152
    },
    "optional_visible_text": {
      "oneOf": [
        {
          "$ref": "#/$defs/visible_text"
        },
        {
          "type": "null"
        }
      ]
    },
    "recall_query_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "source_id": {
      "type": "string",
      "pattern": "^src-[0-9a-f]{40}$"
    },
    "episode_id": {
      "type": "string",
      "pattern": "^ep-[0-9a-f]{40}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^evt-[0-9a-f]{40}$"
    },
    "event_ids": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/event_id"
      }
    },
    "safe_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
    }
  },
  "$comment": "The schema intentionally contains no number type: every numeric value is an integer. It does not modify memory-episode/v1 or memory-event/v2. Adapter metadata and Vault handles are local transport state and must never be copied into durable memory records."
}
