{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-memory-vault.invalid/schemas/memory_event_v2.schema.json",
  "title": "Associative Memory Event v2",
  "description": "Taskless, append-only semantic or continuity edge anchored to visible evidence.",
  "type": "object",
  "required": [
    "schema_version",
    "memory_event_id",
    "kind",
    "confidence",
    "source",
    "claim_key",
    "parents",
    "supersedes",
    "conflicts_with",
    "resolves",
    "payload",
    "payload_sha256",
    "hash_profile",
    "created_at",
    "event_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "memory-event/v2"
    },
    "memory_event_id": {
      "$ref": "#/$defs/event_id"
    },
    "kind": {
      "enum": [
        "decision",
        "constraint",
        "progress",
        "next_action",
        "hypothesis",
        "artifact_created",
        "artifact_verified",
        "correction",
        "user_preference",
        "conflict_declared",
        "conflict_resolved",
        "checkpoint_note"
      ]
    },
    "confidence": {
      "enum": [
        "source_explicit",
        "assistant_inferred"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "source_id",
        "revision_id",
        "source_sequence",
        "evidence_anchor_sha256"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/source_id"
        },
        "revision_id": {
          "$ref": "#/$defs/episode_id"
        },
        "source_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_anchor_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "claim_key": {
      "oneOf": [
        {
          "$ref": "#/$defs/safe_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "parents": {
      "$ref": "#/$defs/event_ids"
    },
    "supersedes": {
      "$ref": "#/$defs/event_ids"
    },
    "conflicts_with": {
      "$ref": "#/$defs/event_ids"
    },
    "resolves": {
      "$ref": "#/$defs/event_ids"
    },
    "payload": {
      "oneOf": [
        {
          "$ref": "#/$defs/episode_payload"
        },
        {
          "$ref": "#/$defs/semantic_payload"
        }
      ]
    },
    "payload_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "hash_profile": {
      "const": "jcs-rfc8785+sha256/event-v2"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "event_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "kind": {
          "const": "checkpoint_note"
        },
        "confidence": {
          "const": "source_explicit"
        },
        "claim_key": {
          "type": "null"
        },
        "parents": {
          "maxItems": 1
        },
        "supersedes": {
          "maxItems": 0
        },
        "conflicts_with": {
          "maxItems": 0
        },
        "resolves": {
          "maxItems": 0
        },
        "payload": {
          "$ref": "#/$defs/episode_payload"
        }
      }
    },
    {
      "properties": {
        "confidence": {
          "const": "assistant_inferred"
        },
        "payload": {
          "$ref": "#/$defs/semantic_payload"
        }
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "conflict_declared"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "conflicts_with": {
            "minItems": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "conflict_resolved"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "resolves": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "event_id": {
      "type": "string",
      "pattern": "^evt-[0-9a-f]{40}$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^src-[0-9a-f]{40}$"
    },
    "episode_id": {
      "type": "string",
      "pattern": "^ep-[0-9a-f]{40}$"
    },
    "safe_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$",
      "not": {
        "enum": ["con", "prn", "aux", "nul", "com1", "com2", "com3", "com4", "com5", "com6", "com7", "com8", "com9", "lpt1", "lpt2", "lpt3", "lpt4", "lpt5", "lpt6", "lpt7", "lpt8", "lpt9"]
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "event_ids": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/event_id"
      }
    },
    "episode_payload": {
      "type": "object",
      "required": [
        "memory_form",
        "profile",
        "message_count",
        "roles",
        "continuity"
      ],
      "properties": {
        "memory_form": {
          "const": "episodic"
        },
        "profile": {
          "const": "memory-network-episode-event/v1"
        },
        "message_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "enum": ["user", "assistant"]
          }
        },
        "continuity": {
          "enum": ["origin", "continues"]
        }
      },
      "additionalProperties": false
    },
    "semantic_payload": {
      "type": "object",
      "required": ["profile", "claim"],
      "properties": {
        "profile": {
          "const": "memory-network-semantic/v1"
        },
        "claim": {
          "type": "object",
          "minProperties": 1
        }
      },
      "additionalProperties": false
    }
  },
  "$comment": "payload_sha256 is SHA-256(JCS(payload)); event_sha256 is SHA-256(JCS(event without event_sha256)). No task or conversation owner field exists."
}
