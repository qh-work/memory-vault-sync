{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-memory-vault.invalid/schemas/memory_episode.schema.json",
  "title": "Visible Memory Episode v1",
  "description": "Immutable visible user/assistant evidence with pseudonymous provenance and no native conversation or task owner.",
  "type": "object",
  "required": [
    "schema_version",
    "episode_id",
    "source_id",
    "source_sequence",
    "parent_episode_ids",
    "captured_at",
    "coverage",
    "included_content",
    "excluded_content",
    "messages",
    "hash_profile",
    "created_at",
    "episode_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "memory-episode/v1"
    },
    "episode_id": {
      "type": "string",
      "pattern": "^ep-[0-9a-f]{40}$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^src-[0-9a-f]{40}$"
    },
    "source_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "parent_episode_ids": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ep-[0-9a-f]{40}$"
      }
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "coverage": {
      "const": "partial_active_turn"
    },
    "included_content": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "excluded_content": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["ordinal", "role", "phase", "text"],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "role": {
            "enum": ["user", "assistant"]
          },
          "phase": {
            "enum": ["commentary", "final_answer", "unknown"]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2097152
          }
        },
        "additionalProperties": false
      }
    },
    "hash_profile": {
      "const": "jcs-rfc8785+sha256/episode-v1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "episode_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    }
  },
  "$comment": "episode_sha256 is SHA-256(JCS(episode without episode_sha256)). source_id is an opaque pseudonym; no source-key hash or native conversation identifier is stored."
}
