{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-memory-vault.invalid/schemas/drive_import.schema.json",
  "title": "Drive Import Manifest v1",
  "description": "A fixed inventory of the 121 verified Drive objects imported by the 2026-07-28 backup transaction.",
  "type": "object",
  "required": [
    "schema_version",
    "import_id",
    "drive_root_id",
    "recorded_at",
    "source_inventories",
    "objects",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": "drive-import/v1"
    },
    "import_id": {
      "$ref": "#/$defs/safe_id"
    },
    "drive_root_id": {
      "$ref": "#/$defs/drive_id"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_inventories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^migration/pending/(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\\\r\\n]+\\.json$",
        "maxLength": 512
      }
    },
    "objects": {
      "type": "array",
      "minItems": 121,
      "maxItems": 121,
      "items": {
        "$ref": "#/$defs/imported_object"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "safe_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$",
      "not": {
        "enum": [
          "con",
          "prn",
          "aux",
          "nul",
          "com1",
          "com2",
          "com3",
          "com4",
          "com5",
          "com6",
          "com7",
          "com8",
          "com9",
          "lpt1",
          "lpt2",
          "lpt3",
          "lpt4",
          "lpt5",
          "lpt6",
          "lpt7",
          "lpt8",
          "lpt9"
        ]
      }
    },
    "drive_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{2,256}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safe_filename": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^/\\\\\\r\\n\\u0000-\\u001f\\u007f]+$"
    },
    "safe_relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\u0000-\\u001f\\u007f]+$"
    },
    "imported_object": {
      "type": "object",
      "required": [
        "drive_file_id",
        "drive_parent_id",
        "display_name",
        "drive_name",
        "logical_path",
        "size",
        "mime_type",
        "sha256",
        "mapping_status",
        "source_inventory",
        "aliases"
      ],
      "properties": {
        "drive_file_id": {
          "$ref": "#/$defs/drive_id"
        },
        "drive_parent_id": {
          "$ref": "#/$defs/drive_id"
        },
        "display_name": {
          "$ref": "#/$defs/safe_filename"
        },
        "drive_name": {
          "$ref": "#/$defs/safe_filename"
        },
        "logical_path": {
          "allOf": [
            {
              "$ref": "#/$defs/safe_relative_path"
            },
            {
              "maxLength": 512
            }
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "mime_type": {
          "type": "string",
          "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$",
          "maxLength": 127
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "mapping_status": {
          "enum": [
            "exact",
            "needs_hash_verification",
            "content_primary",
            "redundant_duplicate"
          ]
        },
        "source_inventory": {
          "type": "string",
          "pattern": "^migration/pending/(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\\\r\\n]+\\.json$",
          "maxLength": 512
        },
        "aliases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safe_relative_path"
          }
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "total_objects",
        "uniquely_mapped_objects",
        "exact",
        "needs_hash_verification",
        "content_primary",
        "redundant_duplicate",
        "path_ambiguous_objects",
        "missing"
      ],
      "properties": {
        "total_objects": {
          "const": 121
        },
        "uniquely_mapped_objects": {
          "type": "integer",
          "minimum": 0
        },
        "exact": {
          "type": "integer",
          "minimum": 0
        },
        "needs_hash_verification": {
          "type": "integer",
          "minimum": 0
        },
        "content_primary": {
          "type": "integer",
          "minimum": 0
        },
        "redundant_duplicate": {
          "type": "integer",
          "minimum": 0
        },
        "path_ambiguous_objects": {
          "type": "integer",
          "minimum": 0
        },
        "missing": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "$comment": "Semantic validation additionally enforces unique drive_file_id/logical_path values, source_inventory membership, exact status counts, and privacy/path safety."
}
