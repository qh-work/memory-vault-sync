{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-memory-vault.invalid/schemas/task.schema.json",
  "title": "Semantic Task Identity v2",
  "description": "任务的稳定身份、用途、隐私边界和迁移来源。任务进度不写在此文件。",
  "type": "object",
  "required": [
    "schema_version",
    "minimum_client_protocol",
    "task_id",
    "display_title",
    "task_type",
    "status",
    "identity_status",
    "purpose",
    "privacy",
    "migration"
  ],
  "properties": {
    "schema_version": {
      "const": "task/v2"
    },
    "minimum_client_protocol": {
      "const": "content-evidence-routing-v1"
    },
    "task_id": {
      "$ref": "#/$defs/safe_id"
    },
    "display_title": {
      "$ref": "#/$defs/safe_human_text"
    },
    "task_type": {
      "enum": [
        "semantic_task",
        "portfolio_coordinator",
        "infrastructure"
      ]
    },
    "status": {
      "enum": [
        "active",
        "paused",
        "archived",
        "split",
        "candidate"
      ]
    },
    "identity_status": {
      "enum": [
        "confirmed",
        "confirmed_from_user_scope",
        "confirmed_semantic_task"
      ]
    },
    "purpose": {
      "$ref": "#/$defs/safe_human_text"
    },
    "privacy": {
      "type": "object",
      "required": [
        "classification",
        "credentials_allowed",
        "raw_runtime_database_allowed"
      ],
      "properties": {
        "classification": {
          "const": "private"
        },
        "credentials_allowed": {
          "const": false
        },
        "raw_runtime_database_allowed": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "lineage": {
      "type": "object",
      "required": [
        "relation",
        "structural_binding",
        "derivation_depth",
        "historical_baseline"
      ],
      "properties": {
        "relation": {
          "enum": [
            "split_child",
            "fork_child"
          ]
        },
        "structural_binding": {
          "type": "string",
          "pattern": "^bindings/(?:structural|confirmed)/[a-z0-9][a-z0-9_-]{1,63}\\.json$"
        },
        "derivation_depth": {
          "type": "integer",
          "minimum": 1
        },
        "historical_baseline": {
          "oneOf": [
            {
              "const": "unknown"
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/safe_id"
                },
                {
                  "not": {
                    "const": "unknown"
                  }
                }
              ]
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "coordinates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/safe_id"
      }
    },
    "content_artifacts_allowed": {
      "const": false
    },
    "migration": {
      "type": "object",
      "required": [
        "legacy_commit"
      ],
      "properties": {
        "legacy_commit": {
          "$ref": "#/$defs/git_object_sha"
        },
        "legacy_task_path": {
          "type": "string",
          "pattern": "^tasks/[a-z0-9][a-z0-9_-]{1,63}/TASK\\.yaml$"
        },
        "legacy_source_id": {
          "$ref": "#/$defs/safe_id"
        },
        "coverage": {
          "enum": [
            "metadata_only",
            "coordination_ready",
            "partial",
            "complete"
          ]
        },
        "conversation_coverage": {
          "enum": [
            "pending",
            "partial",
            "complete",
            "not_available"
          ]
        },
        "task_memory_coverage": {
          "enum": [
            "pending",
            "partial",
            "complete",
            "not_available"
          ]
        },
        "artifact_coverage": {
          "enum": [
            "pending",
            "partial",
            "catalogued",
            "complete",
            "not_available"
          ]
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "legacy_task_path"
          ]
        },
        {
          "required": [
            "legacy_source_id"
          ]
        }
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "task_type": {
            "const": "portfolio_coordinator"
          }
        },
        "required": [
          "task_type"
        ]
      },
      "then": {
        "required": [
          "coordinates",
          "content_artifacts_allowed"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "coordinates"
              ]
            },
            {
              "required": [
                "content_artifacts_allowed"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "lineage"
        ]
      },
      "then": {
        "properties": {
          "task_type": {
            "const": "semantic_task"
          }
        }
      }
    }
  ],
  "$defs": {
    "safe_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$",
      "not": {
        "enum": ["con", "prn", "aux", "nul", "com1", "com2", "com3", "com4", "com5", "com6", "com7", "com8", "com9", "lpt1", "lpt2", "lpt3", "lpt4", "lpt5", "lpt6", "lpt7", "lpt8", "lpt9"]
      }
    },
    "git_object_sha": {
      "type": "string",
      "pattern": "^(?!(?:0{40}|0{64})$)(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "safe_human_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "allOf": [
        {
          "not": {
            "pattern": "(?:^|[\\s\"'])(?:/(?:Users|home|root|tmp|var|private|Volumes|content|mnt)/|[A-Za-z]:[\\\\/]|\\\\\\\\)"
          }
        },
        {
          "not": {
            "pattern": "(?:gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|AIza[0-9A-Za-z_-]{20,}|-----BEGIN [A-Z ]*PRIVATE KEY-----)"
          }
        }
      ]
    }
  },
  "$comment": "Directory name 必须与 task_id byte-for-byte 相同。自由文本仍必须经过凭据扫描；schema 通过严格字段、privacy 常量和常见秘密/绝对路径模式提供第一道阻断。"
}
