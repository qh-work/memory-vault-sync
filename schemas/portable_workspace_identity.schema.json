{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-memory-vault.invalid/schemas/portable_workspace_identity.schema.json",
  "title": "Portable Workspace Identity v1",
  "description": "可随工作文件夹复制的已确认身份。设备实例身份和本地路径不得进入此文件。",
  "type": "object",
  "required": [
    "schema_version",
    "vault_id",
    "binding_id",
    "semantic_task_id",
    "workspace_lineage_id",
    "binding_state",
    "base"
  ],
  "properties": {
    "schema_version": {
      "const": "portable-workspace-identity/v1"
    },
    "vault_id": {
      "const": "codex-memory-vault"
    },
    "binding_id": {
      "$ref": "#/$defs/safe_id"
    },
    "semantic_task_id": {
      "$ref": "#/$defs/safe_id"
    },
    "workspace_lineage_id": {
      "$ref": "#/$defs/safe_id"
    },
    "binding_state": {
      "const": "confirmed"
    },
    "base": {
      "type": "object",
      "required": [
        "snapshot_id",
        "manifest_sha256",
        "current_blob_sha",
        "transaction_id"
      ],
      "properties": {
        "snapshot_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/safe_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "manifest_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "current_blob_sha": {
          "oneOf": [
            {
              "$ref": "#/$defs/git_object_sha"
            },
            {
              "type": "null"
            }
          ]
        },
        "transaction_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/safe_id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "safe_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$",
      "not": {
        "enum": ["con", "prn", "aux", "nul", "com1", "com2", "com3", "com4", "com5", "com6", "com7", "com8", "com9", "lpt1", "lpt2", "lpt3", "lpt4", "lpt5", "lpt6", "lpt7", "lpt8", "lpt9"]
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "git_object_sha": {
      "type": "string",
      "pattern": "^(?!(?:0{40}|0{64})$)(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    }
  },
  "$comment": "workspace_instance_id、path、username、hostname、email、credential 等字段由 additionalProperties:false 明确禁止。"
}
