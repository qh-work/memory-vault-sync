{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UAMP optional signed-v1 public descriptor and detached proofs",
  "$comment": "No private key or trust configuration is an exchange object. Schemas cannot check Ed25519, digest equality, key-ID derivation, Base64 padding bits, registration or revocation; these MUST be checked separately.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schema_version",
        "algorithm",
        "key_id",
        "public_key"
      ],
      "properties": {
        "schema_version": {
          "const": "universal-memory-public-key/v1"
        },
        "algorithm": {
          "const": "Ed25519"
        },
        "key_id": {
          "$ref": "common.schema.json#/$defs/key_id"
        },
        "public_key": {
          "type": "string",
          "minLength": 44,
          "maxLength": 44,
          "pattern": "^[A-Za-z0-9+/]{43}=$",
          "contentEncoding": "base64",
          "description": "32 raw bytes. key_id must equal ed25519_ plus SHA-256 of these bytes."
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema_version",
        "key_id",
        "record_sha256",
        "signature"
      ],
      "properties": {
        "schema_version": {
          "const": "universal-memory-attestation/v1"
        },
        "key_id": {
          "$ref": "common.schema.json#/$defs/key_id"
        },
        "record_sha256": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "signature": {
          "type": "string",
          "minLength": 88,
          "maxLength": 88,
          "pattern": "^[A-Za-z0-9+/]{86}==$",
          "contentEncoding": "base64",
          "description": "Exactly 64 decoded bytes; re-encode to require canonical padding bits. Not an authenticity assertion."
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema_version",
        "key_id",
        "payload_sha256",
        "signature"
      ],
      "properties": {
        "schema_version": {
          "const": "universal-memory-message-signature/v1"
        },
        "key_id": {
          "$ref": "common.schema.json#/$defs/key_id"
        },
        "payload_sha256": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "signature": {
          "type": "string",
          "minLength": 88,
          "maxLength": 88,
          "pattern": "^[A-Za-z0-9+/]{86}==$",
          "contentEncoding": "base64",
          "description": "Exactly 64 decoded bytes; re-encode to require canonical padding bits. Not an authenticity assertion."
        }
      },
      "additionalProperties": false
    }
  ],
  "x-maxUtf8Bytes": 2048
}
