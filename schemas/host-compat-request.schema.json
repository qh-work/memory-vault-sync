{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Memory Vault original host protocol 1.0 request",
  "$comment": "Closed structural contract for memory_vault_compat.py, not the newer lifecycle or core protocol. Byte limits, strict UTF-8, duplicate JSON key rejection, NFC/privacy checks, handle ownership, current trust, content hashes and exact retry semantics are independently enforced by the implementation. Schema conformance grants no authorization. Request framing including LF is at most 3 MiB; a decoded request must also fit the canonical-byte limit.",
  "type": "object",
  "required": ["schema_version", "protocol_version", "request_id", "operation", "adapter", "payload"],
  "properties": {
    "schema_version": {"const": "memory-vault-host-request/v1"},
    "protocol_version": {"const": "1.0"},
    "request_id": {"$ref": "#/$defs/request_id"},
    "operation": {"$ref": "#/$defs/operation"},
    "adapter": {"$ref": "#/$defs/adapter"},
    "payload": {"type": "object"}
  },
  "oneOf": [
    {"properties": {"operation": {"const": "capabilities"}, "payload": {"$ref": "#/$defs/empty"}}},
    {"properties": {"operation": {"const": "memory.status"}, "payload": {"$ref": "#/$defs/empty"}}},
    {"properties": {"operation": {"const": "sync.flush"}, "payload": {"$ref": "#/$defs/empty"}}},
    {"properties": {"operation": {"const": "session.open"}, "payload": {"$ref": "#/$defs/session_open"}}},
    {"properties": {"operation": {"const": "session.close"}, "payload": {"$ref": "#/$defs/session_close"}}},
    {"properties": {"operation": {"const": "turn.input"}, "payload": {"$ref": "#/$defs/turn_input"}}},
    {"properties": {"operation": {"const": "turn.commit"}, "payload": {"$ref": "#/$defs/turn_commit"}}},
    {"properties": {"operation": {"const": "turn.abort"}, "payload": {"$ref": "#/$defs/turn_abort"}}},
    {"properties": {"operation": {"const": "memory.recall"}, "payload": {"$ref": "#/$defs/recall"}}},
    {"properties": {"operation": {"const": "memory.remember"}, "payload": {"$ref": "#/$defs/remember"}}}
  ],
  "additionalProperties": false,
  "x-maxUtf8Bytes": 3145728,
  "$defs": {
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+-]{0,159}$", "not": {"pattern": "[\\r\\n]"}},
    "operation": {"enum": ["capabilities", "session.open", "turn.input", "turn.commit", "turn.abort", "session.close", "memory.recall", "memory.remember", "memory.status", "sync.flush"]},
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$", "not": {"pattern": "[\\r\\n]"}},
    "version": {"type": "string", "maxLength": 64, "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$", "not": {"pattern": "[\\r\\n]"}},
    "continuity_handle": {"type": "string", "pattern": "^mvc1_[A-Za-z0-9_-]{43}$", "not": {"pattern": "[\\r\\n]"}},
    "turn_handle": {"type": "string", "pattern": "^mvt1_[A-Za-z0-9_-]{43}$", "not": {"pattern": "[\\r\\n]"}},
    "episode_id": {"type": "string", "pattern": "^ep-[0-9a-f]{40}$", "not": {"pattern": "[\\r\\n]"}},
    "event_id": {"type": "string", "pattern": "^evt-[0-9a-f]{40}$", "not": {"pattern": "[\\r\\n]"}},
    "source_id": {"type": "string", "pattern": "^src-[0-9a-f]{40}$", "not": {"pattern": "[\\r\\n]"}},
    "semantic_kind": {"enum": ["decision", "constraint", "progress", "next_action", "hypothesis", "artifact_created", "artifact_verified", "correction", "user_preference", "conflict_declared", "conflict_resolved", "checkpoint_note"]},
    "text": {"type": "string", "minLength": 1, "not": {"pattern": "\u0000"}},
    "visible_text": {"$ref": "#/$defs/text", "maxLength": 2097152, "x-maxUtf8Bytes": 2097152},
    "nullable_visible_text": {"oneOf": [{"$ref": "#/$defs/visible_text"}, {"type": "null"}]},
    "nullable_turn_handle": {"oneOf": [{"$ref": "#/$defs/turn_handle"}, {"type": "null"}]},
    "adapter": {
      "type": "object", "required": ["id", "version", "host_family"],
      "properties": {"id": {"$ref": "#/$defs/slug"}, "version": {"$ref": "#/$defs/version"}, "host_family": {"$ref": "#/$defs/slug"}},
      "additionalProperties": false
    },
    "empty": {"type": "object", "maxProperties": 0, "additionalProperties": false},
    "session_open": {
      "type": "object", "required": ["continuity_handle", "reason"],
      "properties": {
        "continuity_handle": {"oneOf": [{"$ref": "#/$defs/continuity_handle"}, {"type": "null"}]},
        "reason": {"enum": ["startup", "resume", "clear", "compact"]}
      },
      "additionalProperties": false
    },
    "session_close": {
      "type": "object", "required": ["continuity_handle"],
      "properties": {"continuity_handle": {"$ref": "#/$defs/continuity_handle"}},
      "additionalProperties": false
    },
    "turn_input": {
      "type": "object", "required": ["continuity_handle", "turn_handle", "visible_user_text", "limit"],
      "properties": {
        "continuity_handle": {"$ref": "#/$defs/continuity_handle"},
        "turn_handle": {"$ref": "#/$defs/nullable_turn_handle"},
        "visible_user_text": {"$ref": "#/$defs/visible_text"},
        "limit": {"type": "integer", "minimum": 1, "maximum": 32}
      },
      "additionalProperties": false
    },
    "turn_commit": {
      "type": "object", "required": ["continuity_handle", "turn_handle", "outcome", "visible_user_text", "visible_assistant_text"],
      "properties": {
        "continuity_handle": {"$ref": "#/$defs/continuity_handle"},
        "turn_handle": {"$ref": "#/$defs/nullable_turn_handle"},
        "outcome": {"const": "final"},
        "visible_user_text": {"$ref": "#/$defs/nullable_visible_text"},
        "visible_assistant_text": {"$ref": "#/$defs/visible_text"}
      },
      "allOf": [{"if": {"properties": {"turn_handle": {"type": "null"}}}, "then": {"properties": {"visible_user_text": {"$ref": "#/$defs/visible_text"}}}}],
      "additionalProperties": false
    },
    "turn_abort": {
      "type": "object", "required": ["continuity_handle", "turn_handle", "reason"],
      "properties": {
        "continuity_handle": {"$ref": "#/$defs/continuity_handle"}, "turn_handle": {"$ref": "#/$defs/turn_handle"},
        "reason": {"enum": ["cancelled", "host_error", "user_interrupt", "unknown"]}
      },
      "additionalProperties": false
    },
    "recall": {
      "type": "object", "required": ["query", "limit", "maximum_context_bytes"],
      "properties": {
        "query": {"$ref": "#/$defs/text", "maxLength": 65536, "x-maxUtf8Bytes": 65536},
        "limit": {"type": "integer", "minimum": 1, "maximum": 32},
        "maximum_context_bytes": {"type": "integer", "minimum": 512, "maximum": 65536}
      },
      "additionalProperties": false
    },
    "event_ids": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/event_id"}},
    "semantic_proposal": {
      "type": "object",
      "required": ["schema_version", "source_id", "episode_id", "kind", "claim_key", "parents", "supersedes", "conflicts_with", "resolves", "payload"],
      "properties": {
        "schema_version": {"const": "memory-network-semantic-proposal/v1"},
        "source_id": {"$ref": "#/$defs/source_id"}, "episode_id": {"$ref": "#/$defs/episode_id"},
        "kind": {"$ref": "#/$defs/semantic_kind"},
        "claim_key": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$", "not": {"type": "string", "pattern": "[\\r\\n]"}},
        "parents": {"$ref": "#/$defs/event_ids"}, "supersedes": {"$ref": "#/$defs/event_ids"},
        "conflicts_with": {"$ref": "#/$defs/event_ids"}, "resolves": {"$ref": "#/$defs/event_ids"},
        "payload": {
          "type": "object", "required": ["statement", "reason", "concepts"],
          "properties": {
            "statement": {"$ref": "#/$defs/text", "maxLength": 16384, "x-maxUtf8Bytes": 16384},
            "reason": {"oneOf": [{"$ref": "#/$defs/text", "maxLength": 8192, "x-maxUtf8Bytes": 8192}, {"type": "null"}]},
            "concepts": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/text", "maxLength": 128, "x-maxUtf8Bytes": 128}}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "remember": {
      "type": "object", "required": ["proposal"],
      "properties": {"proposal": {"$ref": "#/$defs/semantic_proposal"}},
      "additionalProperties": false
    }
  }
}
