{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-memory-vault.invalid/schemas/task_memory_projection.schema.json",
  "title": "Immutable Task State and Handoff Projection v1",
  "description": "随单个任务版本发布的不可变、可重建任务状态与接续胶囊。它只投影已核验的原始证据，不是独立真相。",
  "type": "object",
  "required": [
    "schema_version",
    "projection_id",
    "authority",
    "basis",
    "completeness",
    "current_goal",
    "scope_boundaries",
    "unprojected_deltas",
    "reconciliation_receipts",
    "effective_claims",
    "contested_claims",
    "superseded_claims",
    "rejected_options",
    "artifact_authorities",
    "unclassified_artifact_policy",
    "completed",
    "in_progress",
    "next_actions",
    "open_questions",
    "risks",
    "blocking_conflicts",
    "nonblocking_contradictions",
    "known_gaps",
    "evidence_index",
    "trace_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "task-memory-projection/v1"
    },
    "projection_id": {
      "$ref": "#/$defs/safe_id"
    },
    "authority": {
      "const": "rebuildable_task_handoff_cache"
    },
    "basis": {
      "$ref": "#/$defs/projection_basis"
    },
    "completeness": {
      "$ref": "#/$defs/completeness"
    },
    "completeness_basis": {
      "$ref": "#/$defs/completeness_basis"
    },
    "current_goal": {
      "$ref": "#/$defs/current_goal"
    },
    "scope_boundaries": {
      "description": "任务边界。in_scope 与 out_of_scope 共享同一个 boundary_id 命名空间；ID 必须跨两个列表唯一。新投影若两个列表都为空，必须登记 goal_and_scope known_gap，且不得把该维度宣称为 complete。",
      "$ref": "#/$defs/scope_boundaries"
    },
    "unprojected_deltas": {
      "description": "已核验但尚未经语义整理写入结构化状态的新消息。存在时必须先读取这些消息，再使用较旧的结构化状态。",
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/unprojected_delta"
      }
    },
    "reconciliation_receipts": {
      "description": "本次投影转换新产生的语义对账收据；保存被处理 delta 的原始消息证据及其投影结果索引。既往收据通过不可变版本祖先追溯，不在后续投影中累积复制。",
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reconciliation_receipt"
      }
    },
    "effective_claims": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/effective_claim"
      }
    },
    "contested_claims": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/contested_claim"
      }
    },
    "superseded_claims": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/superseded_claim"
      }
    },
    "rejected_options": {
      "description": "有原始证据支持的已否决方案；option_id 必须唯一。允许为空，严禁为了填满交接清单而虚构被否决方案。",
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/rejected_option"
      }
    },
    "artifact_authorities": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifact_authority"
      }
    },
    "unclassified_artifact_policy": {
      "const": "reference_only_do_not_infer_from_filename_or_inventory"
    },
    "completed": {
      "description": "已完成进度项。item_id 在本列表中唯一，并与 in_progress.item_id、next_actions.action_id 共享互斥的进度身份命名空间。",
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/completed_item"
      }
    },
    "in_progress": {
      "description": "进行中进度项。item_id 在本列表中唯一，并且同一 ID 不得同时出现在 completed 或 next_actions。",
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/in_progress_item"
      }
    },
    "next_actions": {
      "description": "可执行的下一步。action_id 在本列表中唯一，并且同一 ID 不得同时出现在 completed 或 in_progress。新投影存在 active current_goal 却没有下一步时，必须以 progress known_gap 或 completeness_basis.progress=unknown 明示原因。",
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/next_action"
      }
    },
    "open_questions": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/open_question"
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/risk"
      }
    },
    "blocking_conflicts": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/blocking_conflict"
      }
    },
    "nonblocking_contradictions": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonblocking_contradiction"
      }
    },
    "known_gaps": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/known_gap"
      }
    },
    "evidence_index": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidence_index_entry"
      }
    },
    "trace_policy": {
      "$ref": "#/$defs/trace_policy"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "safe_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$",
      "not": {
        "enum": [
          "con",
          "prn",
          "aux",
          "nul",
          "com1",
          "com2",
          "com3",
          "com4",
          "com5",
          "com6",
          "com7",
          "com8",
          "com9",
          "lpt1",
          "lpt2",
          "lpt3",
          "lpt4",
          "lpt5",
          "lpt6",
          "lpt7",
          "lpt8",
          "lpt9"
        ]
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "git_object_sha": {
      "type": "string",
      "pattern": "^(?!(?:0{40}|0{64})$)(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "safe_human_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "allOf": [
        {
          "not": {
            "pattern": "[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]"
          }
        },
        {
          "not": {
            "pattern": "(?:^|[\\s\"'])(?:/(?:Users|home|root|tmp|var|private|Volumes|content|mnt)/|[A-Za-z]:[\\\\/]|\\\\\\\\)"
          }
        },
        {
          "not": {
            "pattern": "(?:gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|AIza[0-9A-Za-z_-]{20,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|Bearer[ \\t]+[A-Za-z0-9._~+/-]{16,}|Cookie[ \\t]*:)"
          }
        }
      ]
    },
    "projection_basis": {
      "type": "object",
      "required": [
        "task_id",
        "snapshot_id",
        "generation",
        "transaction_id",
        "manifest_path",
        "source_current_precondition"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/safe_id"
        },
        "snapshot_id": {
          "$ref": "#/$defs/safe_id"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "transaction_id": {
          "$ref": "#/$defs/safe_id"
        },
        "manifest_path": {
          "type": "string",
          "pattern": "^tasks/[a-z0-9][a-z0-9_-]{1,63}/versions/[a-z0-9][a-z0-9_-]{1,63}\\.json$"
        },
        "source_current_precondition": {
          "oneOf": [
            {
              "$ref": "#/$defs/source_current_precondition"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "source_current_precondition": {
      "type": "object",
      "required": [
        "current_blob_sha",
        "snapshot_id",
        "generation",
        "transaction_id"
      ],
      "properties": {
        "current_blob_sha": {
          "$ref": "#/$defs/git_object_sha"
        },
        "snapshot_id": {
          "$ref": "#/$defs/safe_id"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "transaction_id": {
          "$ref": "#/$defs/safe_id"
        }
      },
      "additionalProperties": false
    },
    "completeness": {
      "type": "object",
      "required": [
        "overall",
        "goal_and_scope",
        "decisions",
        "rationales",
        "progress",
        "artifacts",
        "conflicts",
        "evidence"
      ],
      "properties": {
        "overall": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "goal_and_scope": {
          "$ref": "#/$defs/coverage_level"
        },
        "decisions": {
          "$ref": "#/$defs/coverage_level"
        },
        "rationales": {
          "$ref": "#/$defs/coverage_level"
        },
        "progress": {
          "$ref": "#/$defs/coverage_level"
        },
        "artifacts": {
          "$ref": "#/$defs/coverage_level"
        },
        "conflicts": {
          "$ref": "#/$defs/coverage_level"
        },
        "evidence": {
          "$ref": "#/$defs/coverage_level"
        }
      },
      "additionalProperties": false
    },
    "coverage_level": {
      "enum": [
        "complete",
        "partial",
        "unknown"
      ]
    },
    "completeness_basis": {
      "type": "object",
      "description": "七个完整性维度当前状态的持久理由与证据。未变化维度逐代原样继承；摘要可重建，但本依据不可由摘要替代。",
      "required": [
        "goal_and_scope",
        "decisions",
        "rationales",
        "progress",
        "artifacts",
        "conflicts",
        "evidence"
      ],
      "properties": {
        "goal_and_scope": {
          "$ref": "#/$defs/completeness_basis_entry"
        },
        "decisions": {
          "$ref": "#/$defs/completeness_basis_entry"
        },
        "rationales": {
          "$ref": "#/$defs/completeness_basis_entry"
        },
        "progress": {
          "$ref": "#/$defs/completeness_basis_entry"
        },
        "artifacts": {
          "$ref": "#/$defs/completeness_basis_entry"
        },
        "conflicts": {
          "$ref": "#/$defs/completeness_basis_entry"
        },
        "evidence": {
          "$ref": "#/$defs/completeness_basis_entry"
        }
      },
      "additionalProperties": false
    },
    "completeness_basis_entry": {
      "type": "object",
      "required": [
        "status",
        "reason",
        "evidence"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/coverage_level"
        },
        "reason": {
          "$ref": "#/$defs/safe_human_text"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      },
      "additionalProperties": false
    },
    "current_goal": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "status",
            "statement",
            "evidence"
          ],
          "properties": {
            "status": {
              "const": "active"
            },
            "statement": {
              "$ref": "#/$defs/safe_human_text"
            },
            "evidence": {
              "$ref": "#/$defs/nonempty_evidence"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "status",
            "reason",
            "evidence"
          ],
          "properties": {
            "status": {
              "const": "unknown"
            },
            "reason": {
              "$ref": "#/$defs/safe_human_text"
            },
            "evidence": {
              "$ref": "#/$defs/evidence"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "scope_boundaries": {
      "type": "object",
      "required": [
        "in_scope",
        "out_of_scope"
      ],
      "properties": {
        "in_scope": {
          "$ref": "#/$defs/scope_boundary_items"
        },
        "out_of_scope": {
          "$ref": "#/$defs/scope_boundary_items"
        }
      },
      "additionalProperties": false
    },
    "scope_boundary_items": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/scope_boundary_item"
      }
    },
    "scope_boundary_item": {
      "type": "object",
      "required": [
        "boundary_id",
        "statement",
        "evidence"
      ],
      "properties": {
        "boundary_id": {
          "$ref": "#/$defs/safe_id"
        },
        "statement": {
          "$ref": "#/$defs/safe_human_text"
        },
        "evidence": {
          "$ref": "#/$defs/nonempty_evidence"
        }
      },
      "additionalProperties": false
    },
    "unprojected_delta": {
      "type": "object",
      "required": [
        "delta_id",
        "status",
        "evidence_entry_id",
        "message_evidence",
        "handling"
      ],
      "properties": {
        "delta_id": {
          "$ref": "#/$defs/safe_id"
        },
        "status": {
          "const": "requires_semantic_reconciliation"
        },
        "evidence_entry_id": {
          "$ref": "#/$defs/safe_id"
        },
        "message_evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/source_message_evidence"
          }
        },
        "handling": {
          "const": "read_newest_verified_messages_before_relying_on_prior_structured_state"
        }
      },
      "additionalProperties": false
    },
    "reconciliation_receipt": {
      "type": "object",
      "required": [
        "receipt_id",
        "source_projection_id",
        "resolved_delta_ids",
        "message_evidence",
        "outcome",
        "outcome_rationale",
        "result_refs",
        "retired_refs",
        "retirement_message_evidence",
        "evidence_entry_ids",
        "status"
      ],
      "properties": {
        "receipt_id": {
          "$ref": "#/$defs/safe_id"
        },
        "source_projection_id": {
          "$ref": "#/$defs/safe_id"
        },
        "resolved_delta_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safe_id"
          }
        },
        "message_evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/source_message_evidence"
          }
        },
        "outcome": {
          "enum": [
            "state_updated",
            "evidence_only_no_semantic_change"
          ]
        },
        "outcome_rationale": {
          "$ref": "#/$defs/safe_human_text"
        },
        "result_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reconciliation_result_ref"
          }
        },
        "retired_refs": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reconciliation_retired_ref"
          }
        },
        "retirement_message_evidence": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/source_message_evidence"
          }
        },
        "completeness_transitions": {
          "type": "array",
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/completeness_transition"
          }
        },
        "evidence_entry_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safe_id"
          }
        },
        "status": {
          "const": "semantically_reconciled"
        }
      },
      "additionalProperties": false
    },
    "completeness_transition": {
      "type": "object",
      "required": [
        "dimension",
        "before",
        "after",
        "change_kind",
        "before_basis_sha256",
        "after_basis_sha256",
        "reason",
        "evidence"
      ],
      "properties": {
        "dimension": {
          "enum": [
            "goal_and_scope",
            "decisions",
            "rationales",
            "progress",
            "artifacts",
            "conflicts",
            "evidence"
          ]
        },
        "before": {
          "$ref": "#/$defs/coverage_level"
        },
        "after": {
          "$ref": "#/$defs/coverage_level"
        },
        "change_kind": {
          "enum": [
            "status_changed",
            "basis_refreshed"
          ]
        },
        "before_basis_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "after_basis_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reason": {
          "$ref": "#/$defs/safe_human_text"
        },
        "evidence": {
          "$ref": "#/$defs/nonempty_evidence"
        }
      },
      "additionalProperties": false
    },
    "reconciliation_result_ref": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "current_goal",
            "scope_boundary",
            "effective_claim",
            "contested_claim",
            "superseded_claim",
            "rejected_option",
            "artifact_authority",
            "completed_item",
            "in_progress_item",
            "next_action",
            "open_question",
            "risk",
            "blocking_conflict",
            "nonblocking_contradiction",
            "known_gap",
            "completeness",
            "evidence_index_entry"
          ]
        },
        "id": {
          "$ref": "#/$defs/safe_id"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "current_goal"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "id": {
                "const": "current_goal"
              }
            }
          }
        }
      ]
    },
    "reconciliation_retired_ref": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "scope_boundary",
            "effective_claim",
            "contested_claim",
            "superseded_claim",
            "rejected_option",
            "artifact_authority",
            "completed_item",
            "in_progress_item",
            "next_action",
            "open_question",
            "risk",
            "blocking_conflict",
            "nonblocking_contradiction",
            "known_gap"
          ]
        },
        "id": {
          "$ref": "#/$defs/safe_id"
        }
      },
      "additionalProperties": false
    },
    "claim_kind": {
      "enum": [
        "decision",
        "constraint",
        "user_preference",
        "factual_state",
        "scope_boundary",
        "artifact_selection"
      ]
    },
    "rationale": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "status",
            "statement",
            "evidence"
          ],
          "properties": {
            "status": {
              "const": "known"
            },
            "statement": {
              "$ref": "#/$defs/safe_human_text"
            },
            "evidence": {
              "$ref": "#/$defs/nonempty_evidence"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "status",
            "gap_id",
            "evidence"
          ],
          "properties": {
            "status": {
              "const": "not_recovered"
            },
            "gap_id": {
              "$ref": "#/$defs/safe_id"
            },
            "evidence": {
              "$ref": "#/$defs/evidence"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "effective_claim": {
      "type": "object",
      "required": [
        "claim_id",
        "claim_key",
        "kind",
        "statement",
        "rationale",
        "settled",
        "superseded_claim_ids",
        "reask_policy",
        "evidence"
      ],
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/safe_id"
        },
        "claim_key": {
          "$ref": "#/$defs/safe_id"
        },
        "kind": {
          "$ref": "#/$defs/claim_kind"
        },
        "statement": {
          "$ref": "#/$defs/safe_human_text"
        },
        "rationale": {
          "$ref": "#/$defs/rationale"
        },
        "settled": {
          "const": true
        },
        "superseded_claim_ids": {
          "$ref": "#/$defs/claim_ids"
        },
        "reask_policy": {
          "enum": [
            "do_not_reask",
            "reask_only_on_blocking_conflict",
            "reask_only_if_user_explicitly_reopens",
