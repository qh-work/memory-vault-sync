{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-memory-vault.invalid/schemas/memory_host_response.schema.json",
  "title": "Memory Vault model-neutral host response v1",
  "description": "A closed response envelope carrying cognitive evidence and local durability state without instruction, authorization, policy-change or execution eligibility.",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_version",
    "request_id",
    "operation",
    "status",
    "authority"
  ],
  "properties": {
    "schema_version": {
      "const": "memory-vault-host-response/v1"
    },
    "protocol_version": {
      "const": "1.0"
    },
    "request_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/request_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "operation": {
      "oneOf": [
        {
          "$ref": "#/$defs/operation"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "accepted_local",
        "published",
        "duplicate",
        "degraded",
        "rejected"
      ]
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "result": {
      "$ref": "#/$defs/no_float_object"
    },
    "error": {
      "$ref": "#/$defs/error"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "rejected"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "error"
        ],
        "not": {
          "required": [
            "result"
          ]
        }
      },
      "else": {
        "required": [
          "result"
        ],
        "not": {
          "required": [
            "error"
          ]
        },
        "properties": {
          "request_id": {
            "$ref": "#/$defs/request_id"
          },
          "operation": {
            "$ref": "#/$defs/operation"
          }
        }
      }
    },
    {
      "if": {
        "$ref": "#/$defs/is_session_open_success"
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/session_open_result"
          }
        }
      }
    },
    {
      "if": {
        "$ref": "#/$defs/is_turn_input_success"
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/turn_input_result"
          }
        }
      }
    },
    {
      "if": {
        "$ref": "#/$defs/is_turn_commit_success"
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/turn_commit_result"
          }
        }
      }
    },
    {
      "if": {
        "$ref": "#/$defs/is_turn_abort_success"
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/turn_abort_result"
          }
        }
      }
    },
    {
      "if": {
        "$ref": "#/$defs/is_session_close_success"
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/session_close_result"
          }
        }
      }
    },
    {
      "if": {
        "$ref": "#/$defs/is_memory_recall_success"
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/memory_recall_result"
          }
        }
      }
    }
  ],
  "$defs": {
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+-]{0,159}$"
    },
    "continuity_handle": {
      "type": "string",
      "pattern": "^mvc1_[A-Za-z0-9_-]{43}$"
    },
    "turn_handle": {
      "type": "string",
      "pattern": "^mvt1_[A-Za-z0-9_-]{43}$"
    },
    "operation": {
      "enum": [
        "capabilities",
        "session.open",
        "turn.input",
        "turn.commit",
        "turn.abort",
        "session.close",
        "memory.recall",
        "memory.remember",
        "memory.status",
        "sync.flush"
      ]
    },
    "success_status": {
      "enum": [
        "accepted_local",
        "published",
        "duplicate",
        "degraded"
      ]
    },
    "authority": {
      "type": "object",
      "required": [
        "memory",
        "instruction_eligible",
        "authorization_eligible",
        "execution_eligible",
        "policy_change_eligible",
        "current_user_input_precedence"
      ],
      "properties": {
        "memory": {
          "const": "untrusted_historical_evidence"
        },
        "instruction_eligible": {
          "const": false
        },
        "authorization_eligible": {
          "const": false
        },
        "execution_eligible": {
          "const": false
        },
        "policy_change_eligible": {
          "const": false
        },
        "current_user_input_precedence": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "description": "The rejected response channel contains no free-form message, path, exception, identity or visible content.",
      "required": [
        "code",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "is_session_open_success": {
      "$ref": "#/$defs/success_case_session_open"
    },
    "is_turn_input_success": {
      "$ref": "#/$defs/success_case_turn_input"
    },
    "is_turn_commit_success": {
      "$ref": "#/$defs/success_case_turn_commit"
    },
    "is_turn_abort_success": {
      "$ref": "#/$defs/success_case_turn_abort"
    },
    "is_session_close_success": {
      "$ref": "#/$defs/success_case_session_close"
    },
    "is_memory_recall_success": {
      "$ref": "#/$defs/success_case_memory_recall"
    },
    "success_case_session_open": {
      "$ref": "#/$defs/success_case_base",
      "properties": {
        "operation": {
          "const": "session.open"
        },
        "status": {
          "$ref": "#/$defs/success_status"
        }
      }
    },
    "success_case_turn_input": {
      "$ref": "#/$defs/success_case_base",
      "properties": {
        "operation": {
          "const": "turn.input"
        },
        "status": {
          "$ref": "#/$defs/success_status"
        }
      }
    },
    "success_case_turn_commit": {
      "$ref": "#/$defs/success_case_base",
      "properties": {
        "operation": {
          "const": "turn.commit"
        },
        "status": {
          "$ref": "#/$defs/success_status"
        }
      }
    },
    "success_case_turn_abort": {
      "$ref": "#/$defs/success_case_base",
      "properties": {
        "operation": {
          "const": "turn.abort"
        },
        "status": {
          "$ref": "#/$defs/success_status"
        }
      }
    },
    "success_case_session_close": {
      "$ref": "#/$defs/success_case_base",
      "properties": {
        "operation": {
          "const": "session.close"
        },
        "status": {
          "$ref": "#/$defs/success_status"
        }
      }
    },
    "success_case_memory_recall": {
      "$ref": "#/$defs/success_case_base",
      "properties": {
        "operation": {
          "const": "memory.recall"
        },
        "status": {
          "$ref": "#/$defs/success_status"
        }
      }
    },
    "success_case_base": {
      "type": "object",
      "required": [
        "operation",
        "status"
      ]
    },
    "session_open_result": {
      "type": "object",
      "required": [
        "continuity_handle",
        "sync_state",
        "network_accessed"
      ],
      "properties": {
        "continuity_handle": {
          "$ref": "#/$defs/continuity_handle"
        },
        "sync_state": {
          "$ref": "#/$defs/safe_result_string"
        },
        "network_accessed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "turn_input_result": {
      "type": "object",
      "required": [
        "continuity_handle",
        "turn_handle",
        "evidence_context",
        "network_accessed"
      ],
      "properties": {
        "continuity_handle": {
          "$ref": "#/$defs/continuity_handle"
        },
        "turn_handle": {
          "$ref": "#/$defs/turn_handle"
        },
        "evidence_context": {
          "$ref": "#/$defs/optional_evidence_context"
        },
        "network_accessed": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "turn_commit_result": {
      "type": "object",
      "required": [
        "continuity_handle",
        "turn_handle",
        "outcome",
        "receipt_id",
        "queue_state",
        "network_accessed"
      ],
      "properties": {
        "continuity_handle": {
          "$ref": "#/$defs/continuity_handle"
        },
        "turn_handle": {
          "$ref": "#/$defs/turn_handle"
        },
        "outcome": {
          "const": "final"
        },
        "receipt_id": {
          "$ref": "#/$defs/safe_result_string"
        },
        "queue_state": {
          "$ref": "#/$defs/safe_result_string"
        },
        "network_accessed": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "turn_abort_result": {
      "oneOf": [
        {
          "$ref": "#/$defs/turn_abort_recorded_result"
        },
        {
          "$ref": "#/$defs/turn_abort_committed_result"
        }
      ]
    },
    "turn_abort_recorded_result": {
      "type": "object",
      "required": [
        "continuity_handle",
        "turn_handle",
        "aborted",
        "terminal_state",
        "network_accessed"
      ],
      "properties": {
        "continuity_handle": {
          "$ref": "#/$defs/continuity_handle"
        },
        "turn_handle": {
          "$ref": "#/$defs/turn_handle"
        },
        "aborted": {
          "const": true
        },
        "terminal_state": {
          "const": "aborted"
        },
        "network_accessed": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "turn_abort_committed_result": {
      "type": "object",
      "required": [
        "continuity_handle",
        "turn_handle",
        "aborted",
        "terminal_state",
        "queue_state",
        "network_accessed"
      ],
      "properties": {
        "continuity_handle": {
          "$ref": "#/$defs/continuity_handle"
        },
        "turn_handle": {
          "$ref": "#/$defs/turn_handle"
        },
        "aborted": {
          "const": false
        },
        "terminal_state": {
          "const": "committed"
        },
        "queue_state": {
          "enum": [
            "pending",
            "done"
          ]
        },
        "network_accessed": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "session_close_result": {
      "type": "object",
      "required": [
        "continuity_handle",
        "closed",
        "network_accessed"
      ],
      "properties": {
        "continuity_handle": {
          "$ref": "#/$defs/continuity_handle"
        },
        "closed": {
          "const": true
        },
        "network_accessed": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "memory_recall_result": {
      "type": "object",
      "required": [
        "evidence_context",
        "network_accessed"
      ],
      "properties": {
        "evidence_context": {
          "$ref": "#/$defs/optional_evidence_context"
        },
        "network_accessed": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "optional_evidence_context": {
      "oneOf": [
        {
          "$ref": "#/$defs/evidence_context"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_context": {
      "type": "object",
      "description": "A fixed wrapper around bounded local recall text. The text remains historical evidence and is never eligible as an instruction or authorization.",
      "required": [
        "kind",
        "content_type",
        "authority",
        "instruction_eligible",
        "authorization_eligible",
        "execution_eligible",
        "current_user_input_precedence",
        "truncated",
        "omitted_count",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "evidence_context"
        },
        "content_type": {
          "const": "text/plain"
        },
        "authority": {
          "const": "none"
        },
        "instruction_eligible": {
          "const": false
        },
        "authorization_eligible": {
          "const": false
        },
        "execution_eligible": {
          "const": false
        },
        "current_user_input_precedence": {
          "const": true
        },
        "truncated": {
          "type": "boolean"
        },
        "omitted_count": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        }
      },
      "additionalProperties": false
    },
    "safe_result_string": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "no_float_object": {
      "type": "object",
      "maxProperties": 512,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "additionalProperties": {
        "$ref": "#/$defs/no_float_value"
      }
    },
    "no_float_value": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "string",
          "maxLength": 2097152
        },
        {
          "type": "array",
          "maxItems": 16384,
          "items": {
            "$ref": "#/$defs/no_float_value"
          }
        },
        {
          "$ref": "#/$defs/no_float_object"
        }
      ]
    }
  },
  "$comment": "Successful envelopes contain result and no error; rejected envelopes contain error and no result. Capabilities, semantic-memory, status, and flush results remain recursively bounded no-float objects because their nested diagnostic shapes may evolve within protocol 1.0."
}
