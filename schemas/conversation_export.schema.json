{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-memory-vault.invalid/schemas/conversation_export.schema.json",
  "title": "Sanitized visible conversation export v1",
  "type": "object",
  "required": [
    "schema_version",
    "source_id",
    "title",
    "captured_at",
    "coverage",
    "included_content",
    "excluded_content",
    "messages"
  ],
  "properties": {
    "schema_version": {
      "const": "conversation-export/v1"
    },
    "source_id": {
      "$ref": "#/$defs/safe_id"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "coverage": {
      "enum": [
        "full",
        "partial",
        "partial_active_turn"
      ]
    },
    "included_content": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "excluded_content": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/message"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "safe_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$",
      "not": {
        "enum": ["con", "prn", "aux", "nul", "com1", "com2", "com3", "com4", "com5", "com6", "com7", "com8", "com9", "lpt1", "lpt2", "lpt3", "lpt4", "lpt5", "lpt6", "lpt7", "lpt8", "lpt9"]
      }
    },
    "message": {
      "type": "object",
      "required": [
        "ordinal",
        "role",
        "text"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "enum": [
            "user",
            "assistant"
          ]
        },
        "phase": {
          "enum": [
            "commentary",
            "final_answer",
            "unknown"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
