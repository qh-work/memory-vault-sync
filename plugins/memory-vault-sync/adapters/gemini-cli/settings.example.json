{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "name": "memory-vault-session-start",
            "type": "command",
            "command": "python3 \"/absolute/path/to/memory-vault-sync/adapters/gemini-cli/hook.py\"",
            "timeout": 150000
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "name": "memory-vault-session-resume",
            "type": "command",
            "command": "python3 \"/absolute/path/to/memory-vault-sync/adapters/gemini-cli/hook.py\"",
            "timeout": 150000
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "name": "memory-vault-session-clear",
            "type": "command",
            "command": "python3 \"/absolute/path/to/memory-vault-sync/adapters/gemini-cli/hook.py\"",
            "timeout": 150000
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "name": "memory-vault-recall",
            "type": "command",
            "command": "python3 \"/absolute/path/to/memory-vault-sync/adapters/gemini-cli/hook.py\"",
            "timeout": 15000
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "name": "memory-vault-backup",
            "type": "command",
            "command": "python3 \"/absolute/path/to/memory-vault-sync/adapters/gemini-cli/hook.py\"",
            "timeout": 30000
          }
        ]
      }
    ],
    "PreCompress": [
      {
        "hooks": [
          {
            "name": "memory-vault-compact-checkpoint",
            "type": "command",
            "command": "python3 \"/absolute/path/to/memory-vault-sync/adapters/gemini-cli/hook.py\"",
            "timeout": 5000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "name": "memory-vault-session-end",
            "type": "command",
            "command": "python3 \"/absolute/path/to/memory-vault-sync/adapters/gemini-cli/hook.py\"",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
